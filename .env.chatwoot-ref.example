# Environment for the Chatwoot reference instance used in parity tests.
# Copy to .env.chatwoot-ref and fill in SECRET_KEY_BASE before first boot:
#     openssl rand -hex 64
#
SECRET_KEY_BASE=replace-with-openssl-rand-hex-64

FRONTEND_URL=http://localhost:3001
FORCE_SSL=false
ENABLE_ACCOUNT_SIGNUP=true
DEFAULT_LOCALE=en

# --- DB ---
POSTGRES_HOST=chatwoot-ref-postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=chatwoot
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=chatwoot_ref

# --- Redis ---
REDIS_URL=redis://:chatwoot_ref@chatwoot-ref-redis:6379
REDIS_PASSWORD=chatwoot_ref

# --- Mail (points to shared mailhog) ---
MAILER_SENDER_EMAIL=Chatwoot Ref <noreply@chatwoot.ref>
SMTP_ADDRESS=alostudio-mailhog
SMTP_PORT=1025
SMTP_AUTHENTICATION=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_OPENSSL_VERIFY_MODE=none

# --- Storage (Rails ActiveStorage local for simplicity) ---
ACTIVE_STORAGE_SERVICE=local

# --- Misc ---
USE_INBOX_AVATAR_FOR_BOT=true
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info
RAILS_MAX_THREADS=5
