# Browser → same-origin BFF proxy (Next route handler). The proxy
# attaches the devise auth headers from httpOnly cookies and forwards
# to the FastAPI backend. Keep this same-origin so cookies are sent.
NEXT_PUBLIC_API_BASE=/api/backend

# Server-only: where the BFF proxy forwards to (the FastAPI backend).
# Not exposed to the browser.
BACKEND_INTERNAL_URL=http://localhost:8000

# Used by `npm run gen:api` (orval) to read the OpenAPI schema.
OPENAPI_URL=http://localhost:8000/openapi.json

# Realtime: the ActionCable WebSocket the browser connects to directly
# (auth travels in the subscribe payload, not cookies). Unset = no
# realtime (queries fall back to polling).
NEXT_PUBLIC_CABLE_URL=ws://localhost:8000/cable
