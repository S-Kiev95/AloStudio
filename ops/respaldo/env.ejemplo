# Lo genera configurar.sh en ~/.config/alostudio-respaldo/env (permisos 600).
# Este ejemplo es solo de referencia: no commitear el archivo real, tiene
# las claves de R2 y la URL de aviso.

# Nombre del servidor; separa las copias de cada uno en el bucket.
SERVIDOR=ctc

# Repositorio restic en Cloudflare R2: s3:https://<ACCOUNT_ID>.r2.cloudflarestorage.com/<bucket>/<servidor>
RESTIC_REPOSITORY=s3:https://ACCOUNT_ID.r2.cloudflarestorage.com/alostudio-respaldos/ctc
# La clave del repositorio vive en este archivo (permisos 600). Guardala
# también fuera del servidor (gestor de contraseñas): sin ella las copias
# no se pueden abrir.
RESTIC_PASSWORD_FILE=$HOME/.config/alostudio-respaldo/clave

# Token de API de R2 con lectura y escritura solo sobre el bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto

PG_CONTENEDOR=alostudio-postgres
PG_USUARIO=alostudio
PG_BASE=alostudio
# `docker volume ls`: en CTC alostudio_minio_data, en develop
# alostudio_alostudio_minio_data.
MINIO_VOLUMEN=alostudio_minio_data

# Configuración que también se copia (cifrada) para reconstruir el servidor.
ARCHIVOS_CONFIG="$HOME/AloStudio/.env $HOME/AloStudio/frontend/.env.local $HOME/infra/.env $HOME/infra/docker-compose.yml /etc/caddy/Caddyfile"

# Volcados locales de la base que se conservan en ~/backups.
LOCAL_DIAS=14

# URLs de ping de Healthchecks.io: respaldo diario y prueba mensual.
HC_URL=
HC_URL_PRUEBA=
