# --- Core -----------------------------------------------------------------
APP_ENV=local
APP_NAME=alostudio
LOG_LEVEL=DEBUG
SECRET_KEY=change-me-in-prod-use-openssl-rand-hex-32

# --- Database -------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://alostudio:alostudio@localhost:5433/alostudio
# sync URL used by Alembic for migrations
DATABASE_URL_SYNC=postgresql+psycopg://alostudio:alostudio@localhost:5433/alostudio

# --- Redis ----------------------------------------------------------------
REDIS_URL=redis://localhost:6380/0
ARQ_REDIS_URL=redis://localhost:6380/1

# --- Auth -----------------------------------------------------------------
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=2592000

# --- Mail (dev uses mailhog) ---------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
MAIL_FROM=noreply@alostudio.local

# --- Storage (dev uses minio) --------------------------------------------
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=alostudio
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# --- Parity reference (Chatwoot docker) -----------------------------------
CHATWOOT_REF_BASE_URL=http://localhost:3001
CHATWOOT_REF_API_ACCESS_TOKEN=
CHATWOOT_REF_ADMIN_EMAIL=admin@alostudio.local
CHATWOOT_REF_ADMIN_PASSWORD=Password123!

# --- Meta / Instagram Graph (feat/instagram-graph) ------------------------
# Real secrets belong in the gitignored .env.local, NOT here. Per-account
# Page tokens + IG Business id live on the channel_instagram row, not env.
# IG webhook verification (Phase 5e handshake):
IG_VERIFY_TOKEN=
# Meta app credentials (publishing + OAuth):
META_APP_ID=
META_APP_SECRET=
META_APP_SECRET_LOGIN=
META_GRAPH_API_VERSION=v23.0
# Turn ON to enforce X-Hub-Signature-256 HMAC on inbound IG webhooks
# (recommended in production). OFF preserves the Phase 5e DM mirror.
META_VERIFY_WEBHOOK_SIGNATURE=false
# Turn ON to pre-check the 24h publishing quota before each publish
# (fails the post early when the cap is hit). OFF = one fewer round-trip.
META_CHECK_PUBLISHING_QUOTA=false
