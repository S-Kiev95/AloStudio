# --- Core -----------------------------------------------------------------
APP_ENV=local
APP_NAME=alostudio
LOG_LEVEL=DEBUG
SECRET_KEY=change-me-in-prod-use-openssl-rand-hex-32

# --- Database -------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://alostudio:alostudio@localhost:5433/alostudio
# sync URL used by Alembic for migrations
DATABASE_URL_SYNC=postgresql+psycopg://alostudio:alostudio@localhost:5433/alostudio

# --- Redis ----------------------------------------------------------------
REDIS_URL=redis://localhost:6380/0
ARQ_REDIS_URL=redis://localhost:6380/1

# --- Auth -----------------------------------------------------------------
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=2592000

# --- Mail (dev uses mailhog) ---------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
MAIL_FROM=noreply@alostudio.local

# --- Storage (dev uses minio) --------------------------------------------
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=alostudio
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# --- Parity reference (Chatwoot docker) -----------------------------------
CHATWOOT_REF_BASE_URL=http://localhost:3001
CHATWOOT_REF_API_ACCESS_TOKEN=
CHATWOOT_REF_ADMIN_EMAIL=admin@alostudio.local
CHATWOOT_REF_ADMIN_PASSWORD=Password123!

# --- Meta / Instagram Graph (feat/instagram-graph) ------------------------
# Real secrets belong in the gitignored .env.local, NOT here. Per-account
# Page tokens + IG Business id live on the channel_instagram row, not env.
# IG webhook verification (Phase 5e handshake):
IG_VERIFY_TOKEN=
# Meta app credentials (publishing + OAuth):
META_APP_ID=
META_APP_SECRET=
META_APP_SECRET_LOGIN=
META_GRAPH_API_VERSION=v23.0
# Enforce X-Hub-Signature-256 HMAC on inbound Meta webhooks
# (Instagram, WhatsApp Cloud, Facebook Messenger).
# SECURITY: keep this ON in production — with it OFF, anyone who learns
# a webhook URL can POST forged events that the receiver will process
# (the GET hub.verify_token handshake only gates subscription setup, not
# each POST). Requires META_APP_SECRET to be set (the check fails closed
# if the secret is missing). The code default is OFF only for
# backward-compat with the original unsigned receivers; new/production
# deployments should leave this ON.
META_VERIFY_WEBHOOK_SIGNATURE=true
# Enforce X-Twilio-Signature on inbound Twilio SMS webhooks
# (/twilio/callback). SECURITY: keep ON in production — with it OFF,
# anyone who learns the callback URL can POST forged SMS events. Keyed
# on the per-channel auth_token; fails closed (403) when the channel or
# signature can't be verified. Code default OFF for backward-compat.
TWILIO_VERIFY_SIGNATURE=true
# Turn ON to pre-check the 24h publishing quota before each publish
# (fails the post early when the cap is hit). OFF = one fewer round-trip.
META_CHECK_PUBLISHING_QUOTA=false
# OAuth (I.10). Callback URI registered in the Meta app (must match the
# login dialog + the code exchange byte-for-byte). Serves both flows.
META_OAUTH_REDIRECT_URI=
# Instagram Login flow (no Facebook Page) — the *Instagram* app id/secret
# (under the app's "Instagram > API setup with Instagram login"),
# distinct from META_APP_ID / META_APP_SECRET.
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=
